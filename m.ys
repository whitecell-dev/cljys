!ys-0

ir =: json/load(read('calyx_mcp_v6.json'))
say: '=== RE-EVALUATING RELATIONS (R) ==='
r-map =: ir.'R'
active-relations =: r-map.filter(\(_:second:seq))
say: "Total active protocol relational nodes found: $(active-relations.#)"
say: "\n=== RESOLVING BITWISE ROLE-BITS FROM MODULES ==="
modules =: ir.'M'
module-49 =: nth(modules 49)
say: "Module 49 Profile: $module-49"
each kv active-relations.take(5):
  k =: kv:first
  v =: kv:second
  say: "Module ID: $k -> Actions: $(v.'0')"
